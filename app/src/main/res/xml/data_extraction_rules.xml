<?xml version="1.0" encoding="utf-8"?>
<!--
  The session token and the cached grades never leave the device, so both
  cloud backup and device-to-device transfer are denied outright.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
